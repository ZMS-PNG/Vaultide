{
  "name": "vaultide-learning-connector",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first Obsidian connector for the Vaultide personal learning system.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
